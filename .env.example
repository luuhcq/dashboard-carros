# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
# 5433 no host para evitar conflito com um Postgres nativo já rodando em 5432
POSTGRES_PORT=5433

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origens do frontend, separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Storage: 'local' (filesystem, dev) ou 's3' (S3-compatible, prod)
STORAGE_BACKEND=local

# Só necessário quando STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
